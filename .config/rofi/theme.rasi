/**
 * ROFI Theme - Quickshell & Waybar Dark Match
 * Generated for dotfiles with color tokens from quickshell/Theme.qml and waybar/style.css
 **/

* {
    /* Color Palette */
    bg:             #161622;
    bg-alt:         #1c1d2c;
    bg-hover:       #25273a;
    bg-active:      #1a2c3d;
    
    border-col:     #282b3d;
    border-active:  #47c8ff;
    
    fg:             #ffffff;
    fg-muted:       #8992a8;
    fg-subtle:      #5a627a;
    
    accent:         #47c8ff;
    accent-hover:   #6ad5ff;
    accent-dim:     #1f3b4d;
    
    warning:        #df6124;
    critical:       #f53c3c;
    success:        #25e712;

    /* Typography & Metrics */
    font:           "JetBrainsMono Nerd Font 10";
    
    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            520px;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    8px;
    background-color: @bg;
    padding:          0px;
}

mainbox {
    spacing:          12px;
    padding:          16px;
    children:         [ "inputbar", "message", "listview" ];
}

/* --- Input Bar --- */
inputbar {
    spacing:          10px;
    padding:          10px 14px;
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    6px;
    text-color:       @fg;
    children:         [ "prompt", "entry", "num-filtered-rows" ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 10";
    vertical-align:   0.5;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search...";
    placeholder-color:@fg-muted;
    cursor-color:     @accent;
    vertical-align:   0.5;
}

num-filtered-rows {
    expand:           false;
    text-color:       @fg-subtle;
    vertical-align:   0.5;
}

/* --- List View --- */
listview {
    lines:            7;
    columns:          1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    spacing:          6px;
    fixed-height:     false;
    padding:          2px 0px 0px 0px;
}

/* --- Elements (List Items) --- */
element {
    padding:          8px 12px;
    spacing:          12px;
    border-radius:    6px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-alt;
    text-color:       @fg-muted;
    cursor:           pointer;
    orientation:      horizontal;
}

element-icon {
    size:             22px;
    cursor:           inherit;
    vertical-align:   0.5;
}

element-text {
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    highlight:        bold #47c8ff;
}

/* Element States */
element normal.normal {
    background-color: @bg-alt;
    border-color:     @border-col;
    text-color:       @fg-muted;
}

element alternate.normal {
    background-color: @bg-alt;
    border-color:     @border-col;
    text-color:       @fg-muted;
}

element selected.normal {
    background-color: @bg-hover;
    border-color:     @border-active;
    text-color:       @fg;
}

element normal.active,
element alternate.active {
    background-color: @bg-active;
    border-color:     @accent;
    text-color:       @accent;
}

element selected.active {
    background-color: @bg-active;
    border-color:     @accent-hover;
    text-color:       @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color: @bg-alt;
    border-color:     @warning;
    text-color:       @warning;
}

element selected.urgent {
    background-color: @warning;
    border-color:     @warning;
    text-color:       @bg;
}

/* --- Mode Switcher --- */
mode-switcher {
    spacing:          8px;
    padding:          4px 0px 0px 0px;
}

button {
    padding:          6px 12px;
    border-radius:    6px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-alt;
    text-color:       @fg-muted;
    cursor:           pointer;
}

button selected {
    background-color: @bg-active;
    border-color:     @border-active;
    text-color:       @accent;
}

/* --- Messages & Textbox --- */
message {
    padding:          8px 12px;
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    6px;
}

textbox {
    text-color:       @fg;
    vertical-align:   0.5;
}

error-message {
    padding:          16px;
    border:           1px solid;
    border-color:     @critical;
    border-radius:    8px;
    background-color: @bg;
    text-color:       @critical;
}

