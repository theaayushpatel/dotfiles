{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 40,
  "control-center-margin-bottom": 20,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 5,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 380,
  "control-center-height": 600,
  "notification-window-width": 370,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "scripts": {
    "sound-critical": {
      "exec": "canberra-gtk-play -i dialog-warning -d 'swaync-notification'",
      "urgency": "Critical",
      "run-on": "receive"
    },
    "sound-low": {
      "exec": "canberra-gtk-play -i message -d 'swaync-notification'",
      "urgency": "Low",
      "run-on": "receive"
    },
    "sound-default": {
      "exec": "canberra-gtk-play -i message-new-instant -d 'swaync-notification'",
      "run-on": "receive"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
