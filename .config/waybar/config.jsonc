{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "mod": "dock",
  "passthrough": false,
  "gtk-layer-shell": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "modules-left": [
    "custom/arch",
    "custom/separator",
    "clock",
    "custom/separator",
    "hyprland/workspaces"
    // "custom/separator",
    // "cpu",
    // "memory",
    // "custom/gpu-usage"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    
    
    "network",
    "custom/separator",
    "bluetooth",
    "backlight",
    "custom/separator",
    "pulseaudio#input",
    "pulseaudio#output",
    "custom/separator",
    "group/tray-drawer",
    "custom/notification",
    "custom/separator",
    "power-profiles-daemon",
    "battery"
    // "custom/power"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
    "1": "一",
    "2": "二",
    "3": "三",
    "4": "四",
    "5": "五",
    "6": "六",
    "7": "七",
    "8": "八",
    "9": "九",
    "10": "十"
  },
  "persistent-workspaces": {
        "eDP-1": [1, 2, 3, 4, 5],
        "HDMI-A-1": [6, 7, 8, 9, 10]
    }
  },

"custom/separator": {
    "format": "|", 
    "tooltip": false
},
// "custom/separator2": {
//     "format": "•", 
//     "tooltip": false
// },
"custom/arch": {
    "format": "  ",
    "tooltip": true,
    "tooltip-format": "Open App Launcher",
    "on-click": "rofi -show drun -show-icons" 
},

  // "custom/power": {
  //   "format": "   ",
  //   "on-click": "quickshell ipc -p ~/.config/quickshell call shell togglePower",
  //   "on-click-right": "xdg-terminal-exec",
  //   "tooltip-format": "Power menu\nClick to open"
  // },

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": " ",
      "power-saver": ""
    }
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#47c8ff'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#47c8ff'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#47c8ff'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#47c8ff'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
"cpu": {
    "interval": 5,
    "format": "<span color='#47c8ff'>C</span> {usage:02}%",
    "on-click": "zsh -lc 'ghostty -e btop'",
    "states": {
        "warning": 50,
        "critical": 80
    }
},
"memory": {
    "interval": 5,
    "format": "<span color='#47c8ff'>M</span> {percentage:02}%",
    "tooltip-format": "Used {percentage}%\n{used:0.1f}GB/{total:0.1f}GB",
    "on-click": "zsh -lc 'ghostty -e btop'",
    "states": {
        "warning": 50,
        "critical": 80
    }
},
 "custom/gpu-usage": {
    "exec": "gpu-usage-waybar --text-format '<span color=\"#47c8ff\">G</span> {gpu_utilization}% <span color=\"#47c8ff\">V</span> {mem_utilization}%'",
    "return-type": "json",
    "format": "{}",
    "on-click": "zsh -lc 'ghostty -e nvtop'"
},
 "backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon} {percent}%",
    "tooltip": true,
    "tooltip-format": "Click to open brightness control\nScroll to adjust brightness",
    "format-alt": "{icon} {percent}%",
    "format-alt-click": "click-right",
    "format-icons": ["󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%",
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleBrightness"
  },
   "clock": {
    "format": "<span color='#47c8ff'>{0:%H:%M}</span> <span size='small' color='#ffffff'><i>{0:%a, %b %d}</i></span>",
    "tooltip": false,
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleClock"
  },
  "network": {
    "format": "<span color='#47c8ff'>net</span> on",
    "format-wifi": "<span color='#47c8ff'>wifi</span> {essid}",
    "format-ethernet": "<span color='#47c8ff'>eth</span> on",
    "format-disconnected": "<span color='#47c8ff'>net</span> off",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleNetwork"
  },
"battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "󰂅 {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅 {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell togglePower",
    // "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
 "bluetooth": {
    "format": "{num_connections}",
    "format-disabled": "󰂲 ",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleBluetooth"
  },
"pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "<span color='#47c8ff'>mic</span> {volume}%",
    "format-source-muted": "<span color='#47c8ff'>mic</span> muted",
    "tooltip-format": "{format_source}",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleAudio",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%"
},
"pulseaudio#output": {
    "format": "<span color='#47c8ff'>vol</span> {volume}%",
    "format-muted": "<span color='#47c8ff'>vol</span> muted",
    "tooltip-format": "vol {volume}%",
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleAudio",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},
  "mpris": {
    "format": "{dynamic}",
    "format-paused": "<span color='#47c8ff'>paused</span> {dynamic}",
    "interval": 1, 
    "dynamic-order": ["title", "position", "length"], 
    "dynamic-importance-order": ["position", "length", "title"],
    "tooltip-format": "{player} ({status}):\n{artist} - {title}",  
    "ignored-players": ["firefox", "brave"],
    "on-click": "quickshell ipc -p ~/.config/quickshell call shell toggleMedia",
    "on-click-right": "playerctl play-pause"

  },

  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/tray-icon",
      "tray"
    ]
  },

  "custom/tray-icon": {
    "format": "⟨",
    "tooltip": true,
    "tooltip-format": "System Tray (Click to toggle)"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  }
  // "custom/screenrecording-indicator": {
  //   "on-click": "omarchy-capture-screenrecording",
  //   "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
  //   "signal": 8,
  //   "return-type": "json"
  // },
  
}
